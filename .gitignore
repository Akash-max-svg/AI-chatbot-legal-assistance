# ── Large generated data files (>50MB GitHub limit) ─────────────────────────
# laws.json is tracked via Git LFS (see .gitattributes)
# If LFS is not available, uncomment below to exclude and use buildLawsDB.js to regenerate
# backend/data/laws.json

# Generated bulk files (can be regenerated by running buildBulk.js + genMegaBulk.js etc.)
backend/data/bulk_*.json
backend/data/mega_bulk*.json
backend/data/final_bulk.json
backend/data/batch3.json
backend/data/hma_fixed.json
backend/data/embeddings.json

# Generator scripts output (can be regenerated)
# Keep the source generator scripts, exclude their output

